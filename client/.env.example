# Base URL of the backend API.
# Development: leave this unset. The app then calls /api and the Vite dev server
# proxies it to the Express server on http://localhost:5001 (see vite.config.js).
# VITE_API_URL=
# Production (set this in Vercel's Environment Variables, then redeploy):
# VITE_API_URL=https://your-backend.onrender.com/api
