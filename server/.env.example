# ============================================================
# Portfolio API configuration. Copy this file to ".env".
# Never commit .env: it holds your secrets.
# ============================================================

# ---- Server -------------------------------------------------
# Port the API listens on (optional, default 5000)
PORT=5000
# development | production (optional, default development)
NODE_ENV=development

# ---- Database (REQUIRED to save messages) -------------------
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# ---- CORS (REQUIRED in production) --------------------------
# The frontend URL(s) allowed to call this API, comma-separated, no trailing slash.
CLIENT_URL=http://localhost:5173
# Set to 1 when deployed behind one proxy (Render, Railway, Heroku) so rate limiting sees real IPs.
TRUST_PROXY=0

# ---- Rate limiting (optional) -------------------------------
CONTACT_RATE_WINDOW_MINUTES=15
CONTACT_RATE_MAX=5

# ---- Email notifications (optional) -------------------------
# Leave MAIL_PROVIDER empty to switch notifications off. Messages are still saved.
# resend | smtp | console   (console prints emails in the terminal)
MAIL_PROVIDER=console
# Where new-message notifications are sent (your inbox)
CONTACT_TO_EMAIL=
# Sender shown on the notification, e.g. "Portfolio <hello@yourdomain.com>"
# (Resend requires a verified domain; for testing you can use onboarding@resend.dev)
MAIL_FROM=

# Resend (when MAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP (when MAIL_PROVIDER=smtp). Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
